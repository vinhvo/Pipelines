pipeline {
    parameters {
        // *** In this section you can add strings,booleanParam and modify choices for execution node ***
        choice(choices: ['PRGJENKINSWIN7', 'PRG-Jenkins04','PRG-Jenkins05','PRGJENKINSW10','PRG-Jenkins01','PRG-Jenkins03'], description: 'Choose the agent to execute build', name: 'execution_node')
        booleanParam(name: 'SONAR', defaultValue: true, description: 'Run Sonarqube scan')
        booleanParam(name: 'FORTIFY', defaultValue: true, description: 'Run Fortify scan')
        booleanParam(name: 'RELEASE', defaultValue: false, description: "Set to 'true' to explicitly trigger Release build deploy on Nexus")
        booleanParam(name: 'SNAPSHOT', defaultValue: false, description: "Set to 'true' to explicitly trigger SNAPSHOT build deploy on Nexus")
        booleanParam(name: 'UNIT_TESTS', defaultValue: false, description: 'Run Stage : Unit Tests')
        booleanParam(name: 'NEXUSIQ', defaultValue: true, description: 'Run Nexus IQ scan')
        booleanParam(name: 'SOAPUI', defaultValue: false, description: 'Run Stage : Integration Test SOAPUI')
        booleanParam(name: 'JMETER', defaultValue: false, description: 'Run Stage : Integration Test JMeter')
        booleanParam(name: 'DOCKER', defaultValue: false, description: "Set to 'true' to explicitly trigger DOCKER BUILD and deploy image on DockerHub")
		booleanParam(name: 'JIRA', defaultValue: false, description: "Import JMeter (BlazeMeter) results to JIRA")
		booleanParam(name: 'CLAMAV', defaultValue: false, description: 'Run Stage : CLAMAV Antivirus scan')
    }
    agent { label "${execution_node}" }
    // Please use maven and java version based on your project
    tools {
        maven '3.3.3'
        jdk 'JDK 8u271'
		nodejs 'LTS 18.12.1'
    }
    options
            {
                timestamps()
                skipDefaultCheckout()
                buildDiscarder(logRotator(numToKeepStr: '5', artifactNumToKeepStr: '1'))
            }
    environment
            {
                //General Parameters
                JAVA_TOOL_OPTIONS = "${JAVA_TOOL_OPTIONS}"

                //Nuget tool (If needed use Nuget)
                NUGET = tool name: 'NuGet', type: 'com.cloudbees.jenkins.plugins.customtools.CustomTool'
                PATH = "${PATH};${NUGET}"


                // Maven Settings  (Please contact us regarding MavenSettings to be used)
                GlobalMavenSettings = 'aaa5f927-d914-4396-8a72-9df56ba7bff0'     //No need to change
                MavenSettings = 'bcd1cb67-2b32-4920-8324-2662b1ca328b'  // Change it to yours : DC or Rnd
                MavenVersion = '3.3.3'   // Change it to yours

                //Mail Parameters  -- You can add more recipients in this section with comma --
                MAIL_RECIPIENTS = 'tural.aliyev@external.thalesgroup.com'

                //Repository parameters
                REPOSITORY_URL = 'https://vge1hg.gemalto.com/hg/ICS/DeliveryCenter/Passport/Norway-eP2-eID/Module_4a/Application/Engie'    //Change it to yours
                REPOSITORY_BRANCH = 'develop'   //Change it to yours
                REPOSITORY_CREDS = '7f34684a-afd3-480f-8c35-746727cd542c'  //No need to change

                //Fortify parameters
                FORTIFY_PROJECT = 'GWK20001_Mvn_Pipeline'   //Change to yours and be careful Fortify is case sensitive
                FORTIFY_PROJECT_VERSION = '1.0.0'     //Change it to yours
                FORTIFY_SERVER = 'https://vge1fortify.gemalto.com/ssc'   // No need to change
                FORTIFY_UPLOAD_TOKEN = credentials('ea1781da-b06a-4713-9e50-0514d2396df0')   // No need to change
				SCA_UPLOAD = 'GWK20001_Mvn_Pipeline@1.0.0.mbs'                 // app-name@vers-name.mbs>: --> name of the application and of the version defined on the SSC server
               

                //NexusIQ parameters
                NEXUSIQ_APPID = 'GWK20001_Mvn_Pipeline'   //Change it to yours
                NEXUSIQ_USER = 'ibs_automation'      // No need to change
                NEXUSIQ_GENERIC_SECRET_POWERSHELL = credentials('0c2e2067-87a9-4f12-8c20-6923367a0d09')   // No need to change


                //Sonar parameters
                SONAR_PROJECT_KEY = 'com.gemalto.ics.GWK20001_Mvn_Pipeline'   //Change it to yours but be careful to REGEX (keep com.gemalto.ics.xxx)
                SONAR_HOST = 'https://vge1sonar.gemalto.com'  // No need to change
                SONAR_TOKEN = credentials('af5d14f5-524c-4b96-9dac-3d17960a32ec')   // No need to change

                //Docker parameters
                url = "dockerhub.gemalto.com"   // No need to change
                registryCredential = '0884a94d-4f0b-4d77-9781-51ca63a9d3f7'  // No need to change
                dockerImage = ''   // No need to change

                //SoapUi
                SoapUI = tool name: 'SoapUI', type: 'com.cloudbees.jenkins.plugins.customtools.CustomTool'

                //Jmeter with Taurus
                JMETER = tool name: 'JMeter 5.3', type: 'com.cloudbees.jenkins.plugins.customtools.CustomTool'

                //Xray Jira
                description = "[BUILD_URL|${env.BUILD_URL}]"
                environment = "DEV"  //Change it to yours, it refers to Test Enviroments in Test issue Jira
                projectKey = "GBUDEVTOOL"   //Change it to yours
                xrayConnectorId = '13d64be7-dac9-4929-b170-389a5991eaba'  // No need to change
            }


    stages
            {
                // *** Checkout with Mercurial *** (Remove this stage if you are using GIT )
                stage('Initialization') {
                    steps {
                        println "******************************** $STAGE_NAME ********************************"
                        bat "dir"
                        script { currentBuild.displayName = currentBuild.displayName + " - ${execution_node}" }
                        deleteDir()
                        println "******************************** Checkout Repository ********************************"
                        checkout(
                                changelog: false,
                                poll: false,
                                scm: [$class       : 'MercurialSCM',
                                      credentialsId: """${REPOSITORY_CREDS}""",
                                      installation : 'latest',
                                      revision     : """${REPOSITORY_BRANCH}""",
                                      source       : """${REPOSITORY_URL}"""]
                        )
                    }
					
                }
				
				// *** Checkout with GIT ***  (Remove this stage if you are using Mercurial )
			    stage('Initialization') {
					steps {
						println "******************************** $STAGE_NAME ********************************"
						bat "dir"
                        script { currentBuild.displayName = currentBuild.displayName + " - ${execution_node}" }
                        deleteDir()
						println "******************************** Checkout Repository ********************************"
						checkout([
							$class: 'GitSCM',
							branches: [[name: "${REPOSITORY_BRANCH}"]],
							doGenerateSubmoduleConfigurations: false,
							extensions: [[$class: 'RelativeTargetDirectory', relativeTargetDir: """${SUBDIR}"""]],
							submoduleCfg: [],
							userRemoteConfigs: [[
                        credentialsId: """${REPOSITORY_CREDS}""",
                        url: """${REPOSITORY_URL}"""
                    ]]
                ])
				
				

                stage('Build Release Maven') {
                    when {
                        expression { params.RELEASE == true }
                    }
                    steps
                            {
                                println "******************************** $STAGE_NAME ********************************"
                                withMaven(maven: "${MavenVersion}", mavenSettingsConfig: "${MavenSettings}", globalMavenSettingsConfig: "${GlobalMavenSettings}") {
                                    execute 'mvn clean install -X'
                                }

                            }

                }
				
				// *** BUILD NPM ***  (Remove this stage if you are using Maven )
				stage('Build NPM') {
                    when {
                        expression { params.RELEASE == true }
                    }
                    steps
                            {
                                println "******************************** $STAGE_NAME ********************************"
                                execute 'npm install'
								execute 'npm run build --prod'
                                }

                            }

                }

                stage('Unit Tests') {
                    when {
                        expression { params.UNIT_TESTS == true }
                    }
                    steps {
                        withMaven(maven: "${MavenVersion}", mavenSettingsConfig: "${MavenSettings}", globalMavenSettingsConfig: "${GlobalMavenSettings}") {
                            execute "mvn test -Dmaven.test.failure.ignore=true"
                        }
                    }
                }

                stage('Sonarqube') {
                    when {
                        expression { params.SONAR == true }
                    }
                    steps {
                        withSonarQubeEnv('La Ciotat')
                                {
                                    withMaven(maven: "${MavenVersion}", mavenSettingsConfig: "${MavenSettings}", globalMavenSettingsConfig: "${GlobalMavenSettings}") {
                                        echo "********************************Run SonarQube Scan********************************"
                                        execute "mvn clean install -Dmaven.test.skip=false sonar:sonar -Dsonar.projectKey=\"${SONAR_PROJECT_KEY}\" -Dsonar.host.url=\"${SONAR_HOST}\" -Dsonar.login=\"${SONAR_TOKEN}\""
                                    }
                                }
                    }
                }
                stage('Fortify') {
                    when {
                        expression { params.FORTIFY == true }

                    }
                    steps {
                        println "********************************Run Fortify Analysis********************************"

                        echo "[FORTIFY] Start Fortify Clean"
                        //fortifyClean buildID: "${FORTIFY_PROJECT}"
                        withMaven(maven: "${MavenVersion}", mavenSettingsConfig: "${MavenSettings}", globalMavenSettingsConfig: "${GlobalMavenSettings}") {
                            execute "mvn clean install -P release sca:clean -Dmaven.test.skip=true"
                        }


                        echo "[FORTIFY] Start Fortify Translate"
                        //fortifyTranslate buildID: "${FORTIFY_PROJECT}", projectScanType: fortifyMaven3
                        withMaven(maven: "${MavenVersion}", mavenSettingsConfig: "${MavenSettings}", globalMavenSettingsConfig: "${GlobalMavenSettings}") {
                            execute "mvn sca:translate -Dfortify.sca.buildId=\"${FORTIFY_PROJECT}\""
                        }

                        echo "[FORTIFY] Start Fortify Scan"
                        //fortifyScan buildID: "${FORTIFY_PROJECT}", resultsFile: "${FORTIFY_PROJECT}.fpr"
                        withMaven(maven: "${MavenVersion}", mavenSettingsConfig: "${MavenSettings}", globalMavenSettingsConfig: "${GlobalMavenSettings}") {
                            execute "mvn sca:scan  -Dfortify.sca.resultsFile=\"${WORKSPACE}/${FORTIFY_PROJECT}.fpr\" -Dfortify.sca.buildId=\"${FORTIFY_PROJECT}\""
                        }

                        echo "[FORTIFY] Uploading report"
                        withMaven(maven: "${MavenVersion}", mavenSettingsConfig: "${MavenSettings}", globalMavenSettingsConfig: "${GlobalMavenSettings}") {
                            execute "fortifyclient uploadFPR -f \"${WORKSPACE}/${FORTIFY_PROJECT}.fpr\" -project \"${FORTIFY_PROJECT}\" -version ${FORTIFY_PROJECT_VERSION} -url ${FORTIFY_SERVER} -authtoken ${FORTIFY_UPLOAD_TOKEN}"
                        }

                        // if your Fortify scan is taking too much time, you can move the scan on the SCA server directly
						// Sca Upload for linux use : 'scp' instead of 'D:\\pscp.exe'
                        //execute "D:\\pscp.exe -P 22 -hostkey 8f:54:2d:11:01:cb:38:f4:bf:f2:b6:ce:3b:c2:c0:dc -pw scaupload ${SCA_UPLOAD} scaupload@vge1sca.gemalto.com:${SCA_UPLOAD}"

                    }
                }

                stage('NexusIQ') {
                    when {
                        expression { params.NEXUSIQ == true }
                    }
                    steps {
                        echo "********************************Run Nexus IQ analysis ********************************"
                        // *** In this stage you can add scanPattern and modify powershell and ISL json file based on your project ***
                        nexusPolicyEvaluation iqApplication: "${NEXUSIQ_APPID}", iqScanPatterns: [[scanPattern: '**/*.war'], [scanPattern: 'tools/**/*.jar']],
                                iqStage: 'build'
                        //Read the result and mark the build as unstable if there are open issues
						
						/* To Run ISL analysis uncomment this
                        echo "********************************Run ISL analysis ********************************"
                        // Please refer to confluence documentation for ISL script https://confluence.gemalto.com/display/ICSKS/ISL+automation+module
                        powershell returnStdout: true, script: '''
							$InformationPreference = "Continue";
						Invoke-OssRequestsRegistration -userCredentials (New-Object System.Management.Automation.PSCredential ("$env:NEXUSIQ_USER", (ConvertTo-SecureString "$env:NEXUSIQ_GENERIC_SECRET_POWERSHELL_PSW" -AsPlainText -Force))) -jsonFilesFolder "./Isl"
						''' */
                    }
                }
				
				// *** For CLAMAV usage please refer to this page: https://docs.clamav.net/manual/Usage.html?highlight=usage#usage
				stage('CLAMAV') {
					when {
						expression { params.CLAMAV == true }
						}
					steps {
						echo "********************************Run CLAMAV Antivirus********************************"
						execute "clamscan -r %WORKSPACE%\\* > ClamScanResults.txt"
                
					}		
				}


                stage('Upload Snapshot on Nexus') {
                    when {
                        expression { params.SNAPSHOT == true }
                    }
                    steps {
                        script {
                            withMaven(maven: "${MavenVersion}", mavenSettingsConfig: "${MavenSettings}", globalMavenSettingsConfig: "${GlobalMavenSettings}") {
                                execute "mvn clean deploy -Dmaven.test.skip=true -Pthin -Dbuild.number=${BUILD_NUMBER} -DaltDeploymentRepository=${MAVEN_DC_SNAPSHOTS}"
                            }
                        }
                    }
                }

                // *** In this stage you need to use username for Dockerhub and create Dockerfile ***
                stage('Deploy on Docker') {
                    when {
                        expression { params.DOCKER == true }
                    }
                    steps {
                            //build image and publish to dockerHUB
                            step([$class                     : 'DockerBuilderPublisher',
                                  cleanImages                : true,
                                  cleanupWithJenkinsJobDelete: true,
                                  cloud                      : 'docker-prg01',
                                  dockerFileDirectory        : '.',
                                  fromRegistry               : ["url": "${url}", "credentialsId": "${registryCredential}"],
                                  pushCredentialsId          : """${registryCredential}""",
                                  pushOnSuccess              : true,
                                  tagsString                 : "${url}/ics_jenkins/myapp$BUILD_NUMBER:latest"          //myapp--> your project name and tag latest can be changed
                            ])

                            // run container
                            step([$class: 'DockerBuilderControl',
                                  option: [$class           : 'DockerBuilderControlOptionRun',
                                           cloudName        : 'docker-prg01',     // You can use also docker-prg03
                                           pullCredentialsId: """${registryCredential}""",
                                           image            : "${url}/ics_jenkins/myapp$BUILD_NUMBER:latest",           //myapp--> your project name and tag latest can be changed
                                           //dockerCommand: "--name devops-con",
                                           bindPorts        : "8080:8080" // Change it please with Jenkins admin first
                                  ]])

                            // Stop container --> Container needed to stop manually on Jenkins node by Jenkins Admin.
                        }
                    }

                    // *** In this stage you need to use arguments for testrunner ***
                    stage('Integration Tests SOAPUI') {
                        when {
                            expression { params.SOAPUI == true }
                        }
                        steps {
                            echo "******************************** Integration Test Trigger ********************************"
                            // Please use your own arguments for testrunner like PServiceEndpoint or other's ...
                            execute  "set _JAVA_OPTIONS= -Xms128m -Xmx256m -Dsoapui.properties=soapui.properties"
                            execute "${SoapUI}\\testrunner -M -r -PServiceEndpoint=http://Nor3-Docker02:8097/mockCalculatorSoap -f \"SoapUI_Reports\" -s \"TestSuite 1\" -c \"Add\" \"C:\\Temp\\calculator-soapui-project.xml\""

                        }
                    }

                    stage('Integration Tests JMeter') {
                        when {
                            expression { params.JMETER == true }
                        }
                        steps {
                                parallel(
                                        BlazeMeterTest: {
                                            // Please create your execution.yml and passfail_config.yml
                                            execute 'bzt -v -o settings.artifacts-dir=artifacts execution.yml passfail_config.yml -o modules.blazemeter.report-name="Jenkins Build ${BUILD_NUMBER}"'
                                        },
                                        Analysis: { sleep 60 })
                            }
                        }

                        stage('Upload Release on Nexus') {
                            when {
                                expression { params.RELEASE == true }
                            }
                            steps {
                                script {
                                    withMaven(maven: "${MavenVersion}", mavenSettingsConfig: "${MavenSettings}", globalMavenSettingsConfig: "${GlobalMavenSettings}") {
                                        execute "mvn clean deploy -Dmaven.test.skip=true -Pthin -Dbuild.number=${BUILD_NUMBER} -DaltDeploymentRepository=${MAVEN_DC_RELEASES}"
                                    }
                                }
                            }
                        }


                        stage('Import results to Xray') {
						when {
                                expression { params.JIRA == true }
                            }
                        steps {
                                step([$class           : 'XrayImportBuilder',   // No need to change
                                      endpointName     : '/junit',             // No need to change
                                      importFilePath   : 'junit_report.xml',   // No need to change
                                      fixVersion       : 'jenkins-docker/0.2',  // No need to change
                                      inputInfoSwitcher: 'fileContent',         // No need to change
                                      projectKey       : 'GBUDEVTOOL',          // Change it to yours
                                      serverInstance   : """${xrayConnectorId}""",  // No need to change
                                      importInfo       :                             // Please use your ProjectKey
                                              '''{
				                        "fields": {
					                    "project": {
					                    "key": "GBUDEVTOOL" 
				                         },
				                        "summary": "Automated Regression Execution $(env.BUILD_TIME) ${environment}",
				                        "description": "${description}",
				                        "issuetype": {
				                        "id": "10203" 
				                         },
				                        "customfield_10805": [
				                        "${environment}"
				                         ]
				                       }
			                     }'''

                                ])
                            }
                        }

                    }


                // *** In this stage you can add more Post steps ***
                post {
                    always
                            {
                                step([$class: 'Mailer', recipients: "${MAIL_RECIPIENTS}", sendToIndividuals: true])
                            }
                }
				
			}
			
    // No need to change
    def execute(cmd) {
        if (isUnix()) {
            sh cmd
        } else {
            bat cmd
        }
    }